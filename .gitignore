__pycache__/
*.pyc

# Quartus build output
db/
incremental_db/
output_files/
simulation/
greybox_tmp/
*.qws
*.rpt
*.summary
*.sof
*.rbf
*.pin
*.done
*.jdi
*.sld
*.qdf
*.smsg
build_id.v
jtag.cdf
c5_pin_model_dump.txt
cr_ie_info.json

# Verilator / sim output
sim/obj_dir/
sim/obj_dir_trace/
sim/out/
*.vcd
*.ppm

# copyrighted game data - MAME romsets and any binary dumps derived from
# them never belong in this repo (actual sets live in an external MAME
# install; see tools/verify_mra_stream.py MAME_ROMS_DIR).
*.rom
*.zip

# roms/*.hex are our own generated lookup tables (tools/gen_tables.py),
# not game ROM dumps, but the whole folder stays out of the repo -
# regenerate them locally before building.
roms/

# Releases/ is the MiSTer convention for distributable .rbf + .mra pairs -
# exempt it from the blanket *.rbf ignore above.
!Releases/
!Releases/**

# Verilator sim output
sim/obj_dir/
sim/obj_dir_audio/
sim/out/
sim/*.rom

# design notes, schematics, datasheets, MAME source references, cabinet
# recordings - working material for this repo, not part of the release
docs/
